# -------------------------------------------------------------------
# API KEY TEMPLATE  (this is the EXAMPLE file - safe to share/commit)
#
# HOW TO USE:
#   1. Make a COPY of this file named exactly ".env" (no ".example")
#   2. Paste your real key after the "=" for the provider you're using
#   3. NEVER commit or share the real .env  (.gitignore already blocks it)
#
# You only need ONE key to start - whichever provider you chose.
# We are starting with GEMINI (free).
# -------------------------------------------------------------------

# >>> START HERE <<<
# Groq - FREE, no credit card needed. Get a key at:
#   https://console.groq.com/keys
# The key starts with "gsk_". Paste it after the "=" (no quotes, no spaces).
GROQ_API_KEY=

# --- Optional / later phases ---

# Gemini via Google AI Studio - NOTE: free tier is currently 0 for many
# accounts (needs billing enabled). https://aistudio.google.com/apikey
GEMINI_API_KEY=

# OpenAI (for GPT-4o-mini etc.) - https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Anthropic (for Claude Haiku etc.) - https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Together AI (for open models like Llama - used for the open-model comparison)
#   https://api.together.xyz/
TOGETHER_API_KEY=
